# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

MAGIC_SECRET_KEY=your_magic_secret_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# LLM / xAI (for Grok-mini)
XAI_API_KEY=your_xai_api_key

USE_MOCK_LLM=false
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key

# Encoding
NODE_OPTIONS=--encoding=utf8
CHARSET=utf8

# Polymarket
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
TOKEN_API_URL=https://api.polymarket.com/auth/token
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_SECRET=your_polymarket_secret
POLYMARKET_PASSPHRASE=your_polymarket_passphrase
GAMMA_LIMIT=500

# Tavily Search
TAVILY_API_KEY=your_tavily_api_key

# X (Twitter)
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_BEARER_TOKEN=your_x_bearer_token
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret
X_USERNAME=@your_username

# Virtuals / ACP
VIRTUALS_API_KEY=your_virtuals_api_key
VIRTUALS_AGENT_ID=your_agent_id
VIRTUALS_PRIVATE_KEY=your_private_key
VIRTUALS_TOKEN=VIRTUAL

# Deployment / Scheduling
CRON_SCHEDULE=0 */4 * * *

# Optional
SENTRY_DSN=
PINATA_KEY=
PINATA_SECRET=

# API Configuration
API_KEY=your_api_key_here
REQUEST_TIMEOUT=20000
MAX_RETRIES=3

# Optional: Uncomment and configure if you need a proxy
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port

NODE_ENV=production
LOG_LEVEL=INFO
MAX_MARKETS=2008

ZIGMA_TOKEN_ADDRESS=your_zigma_token_mint_address

# Helius (for Solana token balance checks)
HELIUS_API_KEY=your_helius_api_key
